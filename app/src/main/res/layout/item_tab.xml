<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="38dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_tab_inactive">

    <TextView
        android:id="@+id/tvTabTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#7a8899"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageButton
        android:id="@+id/btnTabClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_ripple_neon"
        android:src="@drawable/ic_close_x"
        android:padding="5dp"
        android:tint="#5a6b7d"
        android:contentDescription="Cerrar pestaña" />

</LinearLayout>
