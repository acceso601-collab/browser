<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080a0f">

    <!-- ═══ PESTAÑAS ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:background="#0a0e14"
        android:paddingTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ BARRA DIRECCIÓN ═══ -->
    <LinearLayout
        android:id="@+id/addressBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#0a0e14"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/rvTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_address_bar"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:tint="#00ffc3"
                android:alpha="0.7"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:textColor="#e2e8f0"
                android:textSize="14sp"
                android:hint="Buscar o escribir URL"
                android:textColorHint="#4a5568"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:selectAllOnFocus="true" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleGamepad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_gamepad"
            android:tint="#5a6b7d"
            android:padding="8dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Gamepad" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_menu_lines"
            android:tint="#e2e8f0"
            android:padding="8dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Menú" />

    </LinearLayout>

    <!-- ═══ PROGRESS BAR (glow neón) ═══ -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressTint="#00ffc3"
        android:progressBackgroundTint="#0a0e14"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/addressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ BÚSQUEDA EN PÁGINA ═══ -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#0a0e14"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:textColor="#e2e8f0"
            android:hint="Buscar en la página..."
            android:textColorHint="#4a5568"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00ffc3"
            android:textSize="12sp"
            android:layout_marginHorizontal="8dp" />

        <ImageButton android:id="@+id/btnSearchPrev"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@android:drawable/arrow_up_float"
            android:tint="#00ffc3" android:contentDescription="Anterior" />

        <ImageButton android:id="@+id/btnSearchNext"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#00ffc3" android:contentDescription="Siguiente" />

        <ImageButton android:id="@+id/btnSearchClose"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_close_x"
            android:tint="#5a6b7d" android:contentDescription="Cerrar" />

    </LinearLayout>

    <!-- ═══ WEBVIEW ═══ -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toTopOf="@id/videoControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ CONTROLES VIDEO ═══ -->
    <LinearLayout
        android:id="@+id/videoControls"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶  Video detectado"
            android:textColor="#00ffc3" android:textSize="12sp" android:paddingStart="14dp" />

        <ImageButton android:id="@+id/btnVideoPlay"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@android:drawable/ic_media_play"
            android:tint="#00ffc3" android:contentDescription="Play/Pause" />

        <ImageButton android:id="@+id/btnVideoFullscreen"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@android:drawable/ic_menu_zoom"
            android:tint="#00ffc3" android:contentDescription="Pantalla completa" />

        <ImageButton android:id="@+id/btnVideoClose"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_close_x"
            android:tint="#5a6b7d" android:contentDescription="Cerrar" />

    </LinearLayout>

    <!-- ═══ BARRA INFERIOR ═══ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnBack"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_back" android:padding="11dp"
            android:tint="#e2e8f0" android:contentDescription="Atrás" />

        <ImageButton android:id="@+id/btnForward"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_forward" android:padding="11dp"
            android:tint="#e2e8f0" android:contentDescription="Adelante" />

        <ImageButton android:id="@+id/btnReload"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_reload" android:padding="11dp"
            android:tint="#e2e8f0" android:contentDescription="Recargar" />

        <ImageButton android:id="@+id/btnSearch"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_search" android:padding="11dp"
            android:tint="#e2e8f0" android:contentDescription="Buscar en página" />

        <ImageButton android:id="@+id/btnAdBlock"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_shield" android:padding="11dp"
            android:tint="#00ffc3" android:contentDescription="Bloqueador" />

        <ImageButton android:id="@+id/btnNewTab"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/btn_ripple_neon"
            android:src="@drawable/ic_add_tab" android:padding="10dp"
            android:contentDescription="Nueva pestaña" />

    </LinearLayout>

    <!-- ═══ GAMEPAD OVERLAY ═══ -->
    <FrameLayout
        android:id="@+id/gamepadOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/videoControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="130dp" android:layout_height="130dp"
            android:layout_gravity="bottom|start" android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp" android:orientation="vertical">
            <Button android:id="@+id/btnUp" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:text="▲" android:textSize="16sp"
                style="@style/GamepadBtn" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:orientation="horizontal">
                <Button android:id="@+id/btnLeft" android:layout_width="44dp" android:layout_height="44dp"
                    android:text="◀" android:textSize="16sp" style="@style/GamepadBtn" />
                <View android:layout_width="44dp" android:layout_height="44dp" android:background="#1e2d40" />
                <Button android:id="@+id/btnRight" android:layout_width="44dp" android:layout_height="44dp"
                    android:text="▶" android:textSize="16sp" style="@style/GamepadBtn" />
            </LinearLayout>
            <Button android:id="@+id/btnDown" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:text="▼" android:textSize="16sp"
                style="@style/GamepadBtn" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnL" android:layout_width="52dp" android:layout_height="36dp"
                android:text="L" android:textSize="13sp" style="@style/GamepadBtnSm" />
            <Button android:id="@+id/btnSelect" android:layout_width="52dp" android:layout_height="36dp"
                android:text="SEL" android:textSize="11sp" android:layout_marginHorizontal="4dp"
                style="@style/GamepadBtnSm" />
            <Button android:id="@+id/btnStart" android:layout_width="52dp" android:layout_height="36dp"
                android:text="STA" android:textSize="11sp" android:layout_marginHorizontal="4dp"
                style="@style/GamepadBtnSm" />
            <Button android:id="@+id/btnR" android:layout_width="52dp" android:layout_height="36dp"
                android:text="R" android:textSize="13sp" style="@style/GamepadBtnSm" />
        </LinearLayout>

        <LinearLayout android:layout_width="130dp" android:layout_height="130dp"
            android:layout_gravity="bottom|end" android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp" android:orientation="vertical">
            <Button android:id="@+id/btnY" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:text="Y" android:textSize="15sp"
                style="@style/GamepadBtnY" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:orientation="horizontal">
                <Button android:id="@+id/btnX" android:layout_width="44dp" android:layout_height="44dp"
                    android:text="X" android:textSize="15sp" style="@style/GamepadBtnX" />
                <View android:layout_width="44dp" android:layout_height="44dp" android:background="#1e2d40" />
                <Button android:id="@+id/btnB" android:layout_width="44dp" android:layout_height="44dp"
                    android:text="B" android:textSize="15sp" style="@style/GamepadBtnB" />
            </LinearLayout>
            <Button android:id="@+id/btnA" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="center_horizontal" android:text="A" android:textSize="15sp"
                style="@style/GamepadBtnA" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
